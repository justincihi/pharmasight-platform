# PharmaSight Platform - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection URL (shared by Flask and Admin Dashboard)
DATABASE_URL=postgresql://pharmasight:changeme@postgres:5432/pharmasight
DB_PASSWORD=changeme

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis connection URL (used by Flask application for caching)
REDIS_URL=redis://redis:6379/0

# ============================================================================
# FLASK APPLICATION CONFIGURATION
# ============================================================================
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-flask-secret-key-change-this
PORT=5000

# ============================================================================
# ADMIN DASHBOARD CONFIGURATION
# ============================================================================
JWT_SECRET=your-jwt-secret-change-this
ADMIN_PORT=3000
NODE_ENV=production

# Flask API URL (for admin dashboard to communicate with Flask app)
FLASK_API_URL=http://flask-app:5000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://app.pharmasight.com,https://admin.pharmasight.com

# ============================================================================
# LLM API KEYS (Optional - can be configured via admin dashboard)
# ============================================================================
# OpenAI API Key
OPENAI_API_KEY=

# Perplexity API Key
PERPLEXITY_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# ============================================================================
# EXTERNAL DATABASE APIs (Optional)
# ============================================================================
# PubChem API (no key required, but can set custom endpoint)
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_API_KEY=

# PubMed API (optional key for higher rate limits)
PUBMED_API_KEY=

# ChEMBL API (no key required)
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data

# DrugBank API (requires registration)
DRUGBANK_API_KEY=

# ZINC Database API (no key required for basic access)
ZINC_API_BASE=https://zinc15.docking.org

# OpenTargets API (no key required)
OPENTARGETS_API_BASE=https://api.platform.opentargets.org/api/v4

# FDA Orange Book API (no key required)
FDA_API_BASE=https://api.fda.gov/drug

# ============================================================================
# BIOTRANSFORMER CONFIGURATION
# ============================================================================
# BioTransformer API base URL
BIOTRANSFORMER_API_BASE=https://biotransformer.ca

# Rate limiting (requests per minute)
BIOTRANSFORMER_RATE_LIMIT=2

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# CSRF protection
WTF_CSRF_ENABLED=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/pharmasight.log

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================
# Gunicorn workers (Flask)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis cache TTL (seconds)
CACHE_TTL=3600

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable specific features
ENABLE_BIOTRANSFORMER=true
ENABLE_QUANTUM_CALCULATIONS=true
ENABLE_AUTONOMOUS_RESEARCH=true
ENABLE_LLM_INTEGRATION=true

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
# Domain configuration
DOMAIN=pharmasight.com
APP_SUBDOMAIN=app
ADMIN_SUBDOMAIN=admin

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ============================================================================
# MONITORING AND ANALYTICS
# ============================================================================
# Sentry DSN (for error tracking)
SENTRY_DSN=

# Google Analytics ID
GA_TRACKING_ID=

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
# Backup directory
BACKUP_DIR=/app/backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ============================================================================
# DEVELOPMENT CONFIGURATION (only for local development)
# ============================================================================
# Enable debug mode (NEVER use in production)
DEBUG=false

# Enable hot reload
HOT_RELOAD=false

# Enable verbose logging
VERBOSE_LOGGING=false
